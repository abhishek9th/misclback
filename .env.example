GROQ_API_KEY=your_groq_api_key_here
PORT=3001

# Supabase (backend, SECRET — server only, never expose the service role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# MSG91 OTP (backend SECRET)
MSG91_AUTHKEY=your_msg91_authkey

# Auth
AUTH_SIGNING_SECRET=generate_a_long_random_string

# Portal credential encryption (backend SECRET, server env only — NEVER in Supabase
# or the frontend). AES-256-GCM key: base64 of 32 random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, the guided journey still works but secure credential storage is disabled.
# Keep this STABLE — changing it makes previously encrypted credentials unreadable.
CREDENTIAL_ENCRYPTION_KEY=generate_a_base64_32byte_key
